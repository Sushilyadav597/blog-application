              "path": ["api", "posts"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page index (0-based)"
                },
                {
                  "key": "size",
                  "value": "10",
                  "description": "Elements per page"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "Sorting property (createdAt, title, id)"
