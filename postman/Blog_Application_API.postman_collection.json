              "mode": "raw",
              "raw": "{\n  \"title\": \"Architecting Scalable Microservices with Spring Boot 3\",\n  \"content\": \"In this article, we delve into designing resilient, event-driven architectures with Spring Boot 3 and Java 21 virtual threads...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Creates a new blog post. Requires JWT authentication. Automatically sets the post author to the authenticated user."
          },
          "response": []
