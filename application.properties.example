# ==============================================================================
# RESTful Blog Application API - Example Configuration Template
# Duplicate this file to 'application.properties' or provide environment variables.
# ==============================================================================
spring.application.name=blog-application-api
server.port=8080

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8)
# Replace with your local or cloud MySQL credentials.
# ------------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=blog_application
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:blog_application}?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME:your_db_username}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# Generate a cryptographically secure 256-bit (32-byte) hex or base64 key in production.
# ------------------------------------------------------------------------------
# JWT_SECRET=your_secret_hex_encoded_key_with_at_least_256_bits_length_here
# JWT_EXPIRATION_MS=86400000 (24 hours)
app.jwt.secret=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}

# ------------------------------------------------------------------------------
# OpenAPI & Swagger UI
# ------------------------------------------------------------------------------
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

